# Shared by the crank and the operator scripts. Never commit real keys.
RPC_URL=https://your-mainnet-rpc

# The crank (the `keeper/` package): an optional open bot that sweeps tax, sells it and
# rebalances positions for tokens nobody is trading through Terp's site. Anyone can run it.
# KEEPER_KEYPAIR is only a fee-paying wallet: any funded key works, it has no privileges
# on-chain and receives nothing. The variable names are historical.
# dry-run simulates every action and sends nothing; live signs and sends.
KEEPER_KEYPAIR=~/.config/solana/crank.json
KEEPER_MODE=dry-run
KEEPER_INTERVAL_MS=15000
KEEPER_SWAP_SLIPPAGE_BPS=100
KEEPER_COLLECT_EVERY_CYCLES=20
KEEPER_STATE_FILE=./crank-state.json
# Shared address lookup table (scripts/create-lookup-table.ts). Needed for Phoenix transactions.
LOOKUP_TABLE=

# Operator scripts
ADMIN_KEYPAIR=~/.config/solana/admin.json
PAYER_KEYPAIR=~/.config/solana/id.json
