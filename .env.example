# Shared by the keeper and the operator scripts. Never commit real keys.
RPC_URL=https://your-mainnet-rpc

# The Terp keeper: the operator's service that sweeps tax, sells it and deploys it.
# KEEPER_KEYPAIR must be the key named as keeper in the protocol config.
# dry-run simulates every action and sends nothing; live signs and sends.
KEEPER_KEYPAIR=~/.config/solana/keeper.json
KEEPER_MODE=dry-run
KEEPER_INTERVAL_MS=15000
KEEPER_SWAP_SLIPPAGE_BPS=100
KEEPER_COLLECT_EVERY_CYCLES=20
KEEPER_STATE_FILE=./keeper-state.json
# Shared address lookup table (scripts/create-lookup-table.ts). Needed for Phoenix transactions.
LOOKUP_TABLE=

# Operator scripts
ADMIN_KEYPAIR=~/.config/solana/admin.json
PAYER_KEYPAIR=~/.config/solana/id.json
