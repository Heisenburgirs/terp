# Solana JSON-RPC endpoint the browser talks to. Required.
# Public endpoints rate-limit and often reject browser origins; use a dedicated provider.
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: override the vault program id baked into the SDK's IDL.
NEXT_PUBLIC_PROGRAM_ID=

# Label shown in the header and used for explorer links: mainnet-beta | devnet | testnet | localnet
NEXT_PUBLIC_CLUSTER=mainnet-beta

# Optional, but needed in practice for redemptions, deployments, deleveraging and claim funding:
# the protocol's shared address lookup table. Those transactions touch about three dozen accounts
# (mostly the same Phoenix accounts every time) and do not fit in one transaction without it.
# The operator creates it once with `scripts/create-lookup-table.ts`, which prints this value.
NEXT_PUBLIC_LOOKUP_TABLE=
